{% extends 'base.html.twig' %}

{% block title %}Hello ArticleController!{% endblock %}

{% block body %}
<section>
    <h2>Students ({{ students|length }})</h2>
    <div>
        <ul>
            {% for student in students %}
                <li>
                    <a href="{{ path('student.show', {id: student.id}) }}">
                        {{ student.firstname }} - {{ student.lastname }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endblock %}
