{% extends 'base.html.twig' %}

{% block title %}Hello ArticleController!{% endblock %}

{% block body %}
<section>
    <h2>Articles ({{ articles|length }})</h2>
    <div>
        <ul>
            {% for article in articles %}
                <li>
                    <a href="{{ path('article.show', {id: article.id}) }}">
                        {{ article.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endblock %}
